#:kivy 2.3.0

<TrendLineChart>:
    size_hint_y: None
    height: dp(140)
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(8),]

<VitalityRoot>:
    orientation: 'vertical'
    canvas.before:
        Color:
            rgba: 0.95, 0.96, 0.97, 1
        Rectangle:
            pos: self.pos
            size: self.size

    # Top Header Bar
    BoxLayout:
        size_hint_y: None
        height: dp(54)
        padding: [dp(16), dp(6)]
        canvas.before:
            Color:
                rgba: 1, 1, 1, 1
            Rectangle:
                pos: self.pos
                size: self.size
            Color:
                rgba: 0.88, 0.91, 0.94, 1
            Line:
                points: [self.x, self.y, self.x + self.width, self.y]
                width: 1.1
        Label:
            text: "Vitality & Glycemic Tracker"
            bold: True
            font_size: '18sp'
            color: 0.12, 0.16, 0.23, 1
            halign: 'left'
            valign: 'middle'
            text_size: self.size

    # Live Status Bar
    Label:
        size_hint_y: None
        height: dp(26)
        text: app.status_text
        font_size: '11sp'
        color: 0.05, 0.58, 0.53, 1
        bold: True
        canvas.before:
            Color:
                rgba: 0.91, 0.97, 0.96, 1
            Rectangle:
                pos: self.pos
                size: self.size

    # Multi-Tab Main Interface
    TabbedPanel:
        do_default_tab: False
        tab_width: dp(85)
        tab_height: dp(40)
        background_color: 0.94, 0.96, 0.98, 1

        # ----------------- TAB 1: DAILY LOG -----------------
        TabbedPanelItem:
            text: "Daily Log"
            color: 0.12, 0.16, 0.23, 1
            background_normal: ''
            background_color: 1, 1, 1, 1
            ScrollView:
                do_scroll_x: False
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    padding: dp(14)
                    spacing: dp(12)

                    # Native Material Calendar Picker Trigger
                    Button:
                        text: "📅 Target Date:  " + app.selected_date + "  (Tap to Change)"
                        size_hint_y: None
                        height: dp(44)
                        bold: True
                        color: 1, 1, 1, 1
                        background_normal: ''
                        background_color: 0.18, 0.45, 0.65, 1
                        on_release: app.show_calendar_picker()

                    # Metrics Inputs
                    GridLayout:
                        cols: 2
                        size_hint_y: None
                        height: dp(76)
                        spacing: dp(10)
                        BoxLayout:
                            orientation: 'vertical'
                            Label:
                                text: "Fasting Sugar (mg/dL)"
                                font_size: '12sp'
                                color: 0.28, 0.35, 0.43, 1
                                halign: 'left'
                                text_size: self.size
                            TextInput:
                                id: sugar_in
                                text: app.current_sugar_str
                                input_filter: 'float'
                                multiline: False
                                foreground_color: 0.12, 0.16, 0.23, 1
                                background_color: 1, 1, 1, 1
                                padding: [dp(10), dp(10)]
                        BoxLayout:
                            orientation: 'vertical'
                            Label:
                                text: "Weight (kg)"
                                font_size: '12sp'
                                color: 0.28, 0.35, 0.43, 1
                                halign: 'left'
                                text_size: self.size
                            TextInput:
                                id: weight_in
                                text: app.current_weight_str
                                input_filter: 'float'
                                multiline: False
                                foreground_color: 0.12, 0.16, 0.23, 1
                                background_color: 1, 1, 1, 1
                                padding: [dp(10), dp(10)]

                    # Habits Checklist Card
                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: dp(145)
                        padding: dp(8)
                        canvas.before:
                            Color:
                                rgba: 1, 1, 1, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(6),]
                            Color:
                                rgba: 0.88, 0.91, 0.94, 1
                            Line:
                                rounded_rectangle: [self.x, self.y, self.width, self.height, dp(6)]
                                width: 1.0

                        GridLayout:
                            cols: 2
                            spacing: dp(4)
                            CheckBox:
                                active: app.chk_ex_m
                                size_hint_x: 0.15
                                color: 0.05, 0.58, 0.53, 1
                                on_active: app.chk_ex_m = self.active
                            Label:
                                text: "Exermet (Morning)"
                                color: 0.18, 0.24, 0.32, 1
                                halign: 'left'
                                text_size: self.size
                            CheckBox:
                                active: app.chk_ex_e
                                size_hint_x: 0.15
                                color: 0.05, 0.58, 0.53, 1
                                on_active: app.chk_ex_e = self.active
                            Label:
                                text: "Exermet (Evening)"
                                color: 0.18, 0.24, 0.32, 1
                                halign: 'left'
                                text_size: self.size
                            CheckBox:
                                active: app.chk_sol_m
                                size_hint_x: 0.15
                                color: 0.05, 0.58, 0.53, 1
                                on_active: app.chk_sol_m = self.active
                            Label:
                                text: "15-Min Soleus Pushups (Morning)"
                                color: 0.18, 0.24, 0.32, 1
                                halign: 'left'
                                text_size: self.size
                            CheckBox:
                                active: app.chk_sol_e
                                size_hint_x: 0.15
                                color: 0.05, 0.58, 0.53, 1
                                on_active: app.chk_sol_e = self.active
                            Label:
                                text: "15-Min Soleus Pushups (Evening)"
                                color: 0.18, 0.24, 0.32, 1
                                halign: 'left'
                                text_size: self.size
                            CheckBox:
                                active: app.chk_pran
                                size_hint_x: 0.15
                                color: 0.05, 0.58, 0.53, 1
                                on_active: app.chk_pran = self.active
                            Label:
                                text: "Pranayama (Bhramari)"
                                color: 0.18, 0.24, 0.32, 1
                                halign: 'left'
                                text_size: self.size
                            CheckBox:
                                active: app.chk_pelv
                                size_hint_x: 0.15
                                color: 0.05, 0.58, 0.53, 1
                                on_active: app.chk_pelv = self.active
                            Label:
                                text: "Pelvic Floor Yoga"
                                color: 0.18, 0.24, 0.32, 1
                                halign: 'left'
                                text_size: self.size

                    # Photo Attachment Row
                    BoxLayout:
                        size_hint_y: None
                        height: dp(40)
                        spacing: dp(10)
                        Button:
                            text: "📷 Link Meal Photo"
                            color: 0.15, 0.22, 0.30, 1
                            background_normal: ''
                            background_color: 0.90, 0.93, 0.96, 1
                            on_release: app.trigger_photo_picker()
                        Label:
                            text: app.image_uri_indicator
                            font_size: '12sp'
                            bold: True
                            color: (0.08, 0.60, 0.35, 1) if "✓" in app.image_uri_indicator else (0.50, 0.55, 0.62, 1)

                    TextInput:
                        id: notes_in
                        text: app.notes_text
                        hint_text: "Food diary, exceptions, or notes..."
                        size_hint_y: None
                        height: dp(60)
                        foreground_color: 0.12, 0.16, 0.23, 1
                        background_color: 1, 1, 1, 1

                    Button:
                        text: "Commit Entry to Local Storage"
                        size_hint_y: None
                        height: dp(46)
                        bold: True
                        color: 1, 1, 1, 1
                        background_normal: ''
                        background_color: 0.09, 0.62, 0.45, 1
                        on_release: app.commit_entry(sugar_in.text, weight_in.text, notes_in.text)

                    Label:
                        text: "Waking Glucose Velocity (Green Line = 100 mg/dL Target)"
                        size_hint_y: None
                        height: dp(24)
                        font_size: '12sp'
                        bold: True
                        color: 0.28, 0.35, 0.43, 1

                    TrendLineChart:
                        id: chart
                        size_hint_y: None
                        height: dp(140)

        # ----------------- TAB 2: HISTORY -----------------
        TabbedPanelItem:
            text: "History"
            color: 0.12, 0.16, 0.23, 1
            background_normal: ''
            background_color: 1, 1, 1, 1
            BoxLayout:
                orientation: 'vertical'
                padding: dp(12)
                spacing: dp(8)
                Button:
                    text: "↻ Refresh Historical Log"
                    size_hint_y: None
                    height: dp(38)
                    bold: True
                    color: 1, 1, 1, 1
                    background_normal: ''
                    background_color: 0.18, 0.45, 0.65, 1
                    on_release: app.refresh_history_table()
                ScrollView:
                    do_scroll_x: False
                    canvas.before:
                        Color:
                            rgba: 1, 1, 1, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(6),]
                    Label:
                        text: app.history_text
                        font_size: '12sp'
                        color: 0.15, 0.22, 0.30, 1
                        size_hint_y: None
                        height: max(self.texture_size[1], dp(300))
                        text_size: self.width - dp(20), None
                        padding: [dp(10), dp(10)]
                        valign: 'top'

        # ----------------- TAB 3: PLAN & AI -----------------
        TabbedPanelItem:
            text: "AI Audit"
            color: 0.12, 0.16, 0.23, 1
            background_normal: ''
            background_color: 1, 1, 1, 1
            ScrollView:
                do_scroll_x: False
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    padding: dp(14)
                    spacing: dp(12)

                    Label:
                        text: "Today's Clinical Schedule"
                        bold: True
                        size_hint_y: None
                        height: dp(24)
                        color: 0.12, 0.16, 0.23, 1

                    BoxLayout:
                        size_hint_y: None
                        height: plan_lbl.texture_size[1] + dp(24)
                        padding: dp(12)
                        canvas.before:
                            Color:
                                rgba: 1, 1, 1, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(6),]
                            Color:
                                rgba: 0.88, 0.91, 0.94, 1
                            Line:
                                rounded_rectangle: [self.x, self.y, self.width, self.height, dp(6)]
                                width: 1.0
                        Label:
                            id: plan_lbl
                            text: app.plan_text
                            color: 0.18, 0.24, 0.32, 1
                            text_size: self.width, None

                    Button:
                        text: "Scan Linked Meal with AI"
                        size_hint_y: None
                        height: dp(42)
                        bold: True
                        color: 1, 1, 1, 1
                        background_normal: ''
                        background_color: 0.05, 0.58, 0.53, 1
                        on_release: app.analyze_linked_photo()

                    Button:
                        text: "Generate AI Action Audit"
                        size_hint_y: None
                        height: dp(42)
                        bold: True
                        color: 1, 1, 1, 1
                        background_normal: ''
                        background_color: 0.18, 0.45, 0.65, 1
                        on_release: app.trigger_ai_report()

                    BoxLayout:
                        size_hint_y: None
                        height: audit_lbl.texture_size[1] + dp(24)
                        padding: dp(12)
                        canvas.before:
                            Color:
                                rgba: 1, 1, 1, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(6),]
                            Color:
                                rgba: 0.88, 0.91, 0.94, 1
                            Line:
                                rounded_rectangle: [self.x, self.y, self.width, self.height, dp(6)]
                                width: 1.0
                        Label:
                            id: audit_lbl
                            text: app.ai_report_output
                            color: 0.12, 0.16, 0.23, 1
                            text_size: self.width, None

        # ----------------- TAB 4: SETTINGS -----------------
        TabbedPanelItem:
            text: "Settings"
            color: 0.12, 0.16, 0.23, 1
            background_normal: ''
            background_color: 1, 1, 1, 1
            BoxLayout:
                orientation: 'vertical'
                padding: dp(16)
                spacing: dp(12)

                Label:
                    text: "Google AI Studio (BYOK Configuration)"
                    bold: True
                    size_hint_y: None
                    height: dp(26)
                    color: 0.12, 0.16, 0.23, 1

                TextInput:
                    id: api_key_field
                    text: app.stored_api_key
                    hint_text: "Paste AIzaSy... API key here"
                    password: True
                    multiline: False
                    size_hint_y: None
                    height: dp(42)
                    foreground_color: 0.12, 0.16, 0.23, 1
                    background_color: 1, 1, 1, 1
                    padding: [dp(10), dp(10)]

                Button:
                    text: "Save & Validate Key"
                    size_hint_y: None
                    height: dp(44)
                    bold: True
                    color: 1, 1, 1, 1
                    background_normal: ''
                    background_color: 0.05, 0.58, 0.53, 1
                    on_release: app.save_api_key(api_key_field.text)

                Label:
                    text: "Active Storage: Local Isolated SQLite Database\nKeys and clinical entries remain strictly on-device."
                    size_hint_y: None
                    height: dp(50)
                    font_size: '12sp'
                    color: 0.45, 0.52, 0.60, 1

                Widget: